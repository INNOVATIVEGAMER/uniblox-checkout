@base = http://localhost:3000

### List products
GET {{base}}/products

### Admin: change the lamp's price and stock
PATCH {{base}}/admin/products/p_lamp
Content-Type: application/json

{ "pricePaise": 199999, "stock": 10 }

### Admin: rename a product
PATCH {{base}}/admin/products/p_cable
Content-Type: application/json

{ "name": "Braided USB-C Cable" }

### 400 VALIDATION_ERROR: an empty PATCH
PATCH {{base}}/admin/products/p_lamp
Content-Type: application/json

{}

### 400 VALIDATION_ERROR: an unknown field
PATCH {{base}}/admin/products/p_lamp
Content-Type: application/json

{ "stock": 5, "colour": "red" }

### 400 VALIDATION_ERROR: a malformed product ID
PATCH {{base}}/admin/products/LAMP
Content-Type: application/json

{ "stock": 5 }

### 400 VALIDATION_ERROR: a non-JSON Content-Type
PATCH {{base}}/admin/products/p_lamp
Content-Type: text/plain

{ "stock": 5 }

### 404 PRODUCT_NOT_FOUND
PATCH {{base}}/admin/products/p_nope
Content-Type: application/json

{ "stock": 5 }

### 404 NOT_FOUND: an unknown route
GET {{base}}/nope

### Cart walkthrough: create a cart
# @name createCart
POST {{base}}/carts

### Add 3 cables (201)
PUT {{base}}/carts/{{createCart.response.body.id}}/items/p_cable
Content-Type: application/json

{ "quantity": 3 }

### Send the same PUT again: still 3 cables (200)
PUT {{base}}/carts/{{createCart.response.body.id}}/items/p_cable
Content-Type: application/json

{ "quantity": 3 }

### Add a mouse
PUT {{base}}/carts/{{createCart.response.body.id}}/items/p_mouse
Content-Type: application/json

{ "quantity": 1 }

### View the cart: subtotal 234947
GET {{base}}/carts/{{createCart.response.body.id}}

### Remove the mouse (200). Sending it again also returns 200
DELETE {{base}}/carts/{{createCart.response.body.id}}/items/p_mouse

### 409 INSUFFICIENT_STOCK: 4 lamps when 3 are in stock
PUT {{base}}/carts/{{createCart.response.body.id}}/items/p_lamp
Content-Type: application/json

{ "quantity": 4 }

### 400 VALIDATION_ERROR: quantity above 1000
PUT {{base}}/carts/{{createCart.response.body.id}}/items/p_cable
Content-Type: application/json

{ "quantity": 1001 }

### 404 CART_NOT_FOUND
GET {{base}}/carts/0b8f2d4e-6a1c-4e3b-8d5f-7a9c1e3b5d7f

### Checkout walkthrough: a cart with 2 cables
# @name payCart
POST {{base}}/carts

###
PUT {{base}}/carts/{{payCart.response.body.id}}/items/p_cable
Content-Type: application/json

{ "quantity": 2 }

### Pay (201). The total comes from the cart view
# @name paid
POST {{base}}/carts/{{payCart.response.body.id}}/checkout
Content-Type: application/json
Idempotency-Key: walkthrough-pay-1

{ "expectedTotalPaise": 69998, "paymentToken": "pm_card_visa" }

### Replay: the same key returns the same order (201), with Idempotent-Replayed: true, and charges nothing
POST {{base}}/carts/{{payCart.response.body.id}}/checkout
Content-Type: application/json
Idempotency-Key: walkthrough-pay-1

{ "expectedTotalPaise": 69998, "paymentToken": "pm_card_visa" }

### 422 IDEMPOTENCY_KEY_REUSED: the same key with another token
POST {{base}}/carts/{{payCart.response.body.id}}/checkout
Content-Type: application/json
Idempotency-Key: walkthrough-pay-1

{ "expectedTotalPaise": 69998, "paymentToken": "pm_card_chargeDeclined" }

### The order
GET {{base}}/orders/{{paid.response.body.id}}

### 409 CART_CHECKED_OUT: a new key on the paid cart
POST {{base}}/carts/{{payCart.response.body.id}}/checkout
Content-Type: application/json
Idempotency-Key: walkthrough-pay-2

{ "expectedTotalPaise": 69998, "paymentToken": "pm_card_visa" }

### Decline walkthrough: a cart with 1 mouse
# @name declineCart
POST {{base}}/carts

###
PUT {{base}}/carts/{{declineCart.response.body.id}}/items/p_mouse
Content-Type: application/json

{ "quantity": 1 }

### 409 PRICE_CHANGED: a stale total, with the current breakdown
POST {{base}}/carts/{{declineCart.response.body.id}}/checkout
Content-Type: application/json
Idempotency-Key: walkthrough-stale-1

{ "expectedTotalPaise": 1, "paymentToken": "pm_card_visa" }

### 402 PAYMENT_FAILED: declined. The stock is released and the cart reopens
POST {{base}}/carts/{{declineCart.response.body.id}}/checkout
Content-Type: application/json
Idempotency-Key: walkthrough-decline-1

{ "expectedTotalPaise": 129950, "paymentToken": "pm_card_chargeDeclined" }

### The same key replays the 402
POST {{base}}/carts/{{declineCart.response.body.id}}/checkout
Content-Type: application/json
Idempotency-Key: walkthrough-decline-1

{ "expectedTotalPaise": 129950, "paymentToken": "pm_card_chargeDeclined" }

### A new key pays (201)
POST {{base}}/carts/{{declineCart.response.body.id}}/checkout
Content-Type: application/json
Idempotency-Key: walkthrough-decline-2

{ "expectedTotalPaise": 129950, "paymentToken": "pm_card_visa" }

### 400 IDEMPOTENCY_KEY_INVALID: no key
POST {{base}}/carts/{{declineCart.response.body.id}}/checkout
Content-Type: application/json

{ "expectedTotalPaise": 129950, "paymentToken": "pm_card_visa" }

### 404 ORDER_NOT_FOUND
GET {{base}}/orders/0b8f2d4e-6a1c-4e3b-8d5f-7a9c1e3b5d7f
