@base = http://localhost:3000

### List products
GET {{base}}/products

### Admin: change the lamp's price and stock
PATCH {{base}}/admin/products/p_lamp
Content-Type: application/json

{ "pricePaise": 199999, "stock": 10 }

### Admin: rename a product
PATCH {{base}}/admin/products/p_cable
Content-Type: application/json

{ "name": "Braided USB-C Cable" }

### 400 VALIDATION_ERROR: an empty PATCH
PATCH {{base}}/admin/products/p_lamp
Content-Type: application/json

{}

### 400 VALIDATION_ERROR: an unknown field
PATCH {{base}}/admin/products/p_lamp
Content-Type: application/json

{ "stock": 5, "colour": "red" }

### 400 VALIDATION_ERROR: a malformed product ID
PATCH {{base}}/admin/products/LAMP
Content-Type: application/json

{ "stock": 5 }

### 400 VALIDATION_ERROR: a non-JSON Content-Type
PATCH {{base}}/admin/products/p_lamp
Content-Type: text/plain

{ "stock": 5 }

### 404 PRODUCT_NOT_FOUND
PATCH {{base}}/admin/products/p_nope
Content-Type: application/json

{ "stock": 5 }

### 404 NOT_FOUND: an unknown route
GET {{base}}/nope

### Cart walkthrough: create a cart
# @name createCart
POST {{base}}/carts

### Add 3 cables (201)
PUT {{base}}/carts/{{createCart.response.body.id}}/items/p_cable
Content-Type: application/json

{ "quantity": 3 }

### Send the same PUT again: still 3 cables (200)
PUT {{base}}/carts/{{createCart.response.body.id}}/items/p_cable
Content-Type: application/json

{ "quantity": 3 }

### Add a mouse
PUT {{base}}/carts/{{createCart.response.body.id}}/items/p_mouse
Content-Type: application/json

{ "quantity": 1 }

### View the cart: subtotal 234947
GET {{base}}/carts/{{createCart.response.body.id}}

### Remove the mouse (200). Sending it again also returns 200
DELETE {{base}}/carts/{{createCart.response.body.id}}/items/p_mouse

### 409 INSUFFICIENT_STOCK: 4 lamps when 3 are in stock
PUT {{base}}/carts/{{createCart.response.body.id}}/items/p_lamp
Content-Type: application/json

{ "quantity": 4 }

### 400 VALIDATION_ERROR: quantity above 1000
PUT {{base}}/carts/{{createCart.response.body.id}}/items/p_cable
Content-Type: application/json

{ "quantity": 1001 }

### 404 CART_NOT_FOUND
GET {{base}}/carts/0b8f2d4e-6a1c-4e3b-8d5f-7a9c1e3b5d7f
